<Window x:Class="MorseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Morse Code Learner - Assistive x64 Platform" 
        Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#121212">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Top Header -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="⚡ MORSE CODE LEARNER" FontSize="20" FontWeight="Bold" Foreground="#FFD600" VerticalAlignment="Center" />
                    <TextBlock Text=" │ MASM x64 Native Core" FontSize="14" Foreground="#A0A0A0" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="SPEED: 15 WPM" FontSize="14" FontWeight="SemiBold" Foreground="#00E5FF" Margin="16,0" VerticalAlignment="Center" />
                    <TextBlock Text="SIDETONE: 700 Hz" FontSize="14" FontWeight="SemiBold" Foreground="#00E5FF" Margin="16,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <!-- Drill Card -->
            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Margin="0,0,16,0" Padding="24">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="TARGET DRILL CHARACTER" FontSize="14" FontWeight="Bold" Foreground="#A0A0A0" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TargetCharText" Text="A" FontSize="110" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,8" />
                    <TextBlock x:Name="TargetMorseText" Text="• ─" FontSize="36" FontWeight="Bold" Foreground="#FFD600" HorizontalAlignment="Center" />
                    <TextBlock Text="Phonetic: di-dah" FontSize="18" FontStyle="Italic" Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,8" />
                    <Border Background="#121212" CornerRadius="6" Padding="12" Margin="0,24,0,0" MinWidth="420">
                        <StackPanel>
                            <TextBlock Text="DECODED OUTPUT STREAM:" FontSize="12" FontWeight="Bold" Foreground="#A0A0A0" />
                            <TextBlock x:Name="DecodedStreamText" Text="" FontSize="28" FontFamily="Consolas" FontWeight="Bold" Foreground="#00E5FF" Margin="0,4" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <!-- Signal Beacon Display (Self-Contained) -->
            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="24">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="VISUAL SIGNAL BEACON" FontSize="14" FontWeight="Bold" Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,0,0,24" />

                    <Grid Width="160" Height="160">
                        <Ellipse Width="150" Height="150" Stroke="#333333" StrokeThickness="4" />
                        <Ellipse x:Name="SignalBulb" Width="120" Height="120" Fill="#2A2A2A">
                            <Ellipse.Effect>
                                <BlurEffect x:Name="SignalGlow" Radius="0" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="SignalStatusText" Text="KEY UP" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="CURRENT BUFFER:" FontSize="12" FontWeight="Bold" Foreground="#A0A0A0" Margin="0,24,0,4" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CurrentTokenBuffer" Text="" FontSize="32" FontFamily="Consolas" FontWeight="Bold" Foreground="#FFD600" HorizontalAlignment="Center" />
                    <Border Background="#121212" CornerRadius="4" Padding="8" Margin="0,20,0,0">
                        <TextBlock Text="PRESS [SPACEBAR] OR ASSISTIVE SWITCH" FontSize="11" FontWeight="Bold" Foreground="#A0A0A0" TextAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Bottom Telemetry Bar -->
        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="8" Padding="12,16" Margin="0,16,0,0">
            <UniformGrid Columns="4">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="LAST DURATION" FontSize="11" Foreground="#A0A0A0" />
                    <TextBlock x:Name="DurationMetric" Text="0 ms" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="CLASSIFIED TOKEN" FontSize="11" Foreground="#A0A0A0" />
                    <TextBlock x:Name="TokenMetric" Text="NONE" FontSize="18" FontWeight="Bold" Foreground="#FFD600" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="TIMING JITTER" FontSize="11" Foreground="#A0A0A0" />
                    <TextBlock x:Name="JitterMetric" Text="±0.0 ms" FontSize="18" FontWeight="Bold" Foreground="#00E5FF" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="MASM CORE LATENCY" FontSize="11" Foreground="#A0A0A0" />
                    <TextBlock Text="&lt; 0.05 μs (O(1))" FontSize="18" FontWeight="Bold" Foreground="#00E676" />
                </StackPanel>
            </UniformGrid>
        </Border>
    </Grid>
</Window>