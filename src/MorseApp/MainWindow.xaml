<Window x:Class="MorseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MorseApp.Controls"
        Title="Morseling - Assistive x64 Assembly Platform"
        Icon="Assets/morseling-icon.png"
        Height="800" Width="1240" MinHeight="660" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <!-- ============================================================
         DESIGN LANGUAGE: "SIGNAL DESK"
         Light by default (warm paper + vermilion signal); dark toggle
         (graphite + electric lime). Every colour is a DynamicResource so
         the whole UI re-themes live. Glass cards over drifting colour blobs.
         ============================================================ -->
    <Window.Resources>
        <!-- LIGHT THEME (default). Code-behind swaps these values for dark. -->
        <SolidColorBrush x:Key="Bg"       Color="#E8E3D6" />
        <SolidColorBrush x:Key="Rail"     Color="#F0ECE0" />
        <SolidColorBrush x:Key="Surface"  Color="#E8F4F0E6" />
        <SolidColorBrush x:Key="Raised"   Color="#E4DECF" />
        <SolidColorBrush x:Key="Line"     Color="#CBC2AD" />
        <SolidColorBrush x:Key="Text"     Color="#1B1A17" />
        <SolidColorBrush x:Key="Muted"    Color="#55524A" />
        <SolidColorBrush x:Key="Signal"   Color="#FF6B2C" />
        <SolidColorBrush x:Key="Accent"   Color="#AE3700" />
        <SolidColorBrush x:Key="Ice"      Color="#1A4FB4" />
        <SolidColorBrush x:Key="Mint"     Color="#0A6B49" />
        <SolidColorBrush x:Key="Alert"    Color="#B42318" />
        <SolidColorBrush x:Key="OnSignal" Color="#1B0F07" />
        <SolidColorBrush x:Key="OnMint"   Color="#FFFFFF" />
        <SolidColorBrush x:Key="Well"     Color="#FAF7EF" />

        <Color x:Key="SignalColor">#FF6B2C</Color>
        <Color x:Key="IceColor">#1A4FB4</Color>
        <Color x:Key="RaisedColor">#E4DECF</Color>
        <Color x:Key="WellColor">#FAF7EF</Color>

        <FontFamily x:Key="Display">Bahnschrift, Segoe UI</FontFamily>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        </Style>

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>

        <Style x:Key="KeyBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource Raised}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="Base" Background="{TemplateBinding Background}" CornerRadius="11"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Sheen" CornerRadius="11" Background="{DynamicResource Text}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.07" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.14" />
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SignalBtn" TargetType="Button" BasedOn="{StaticResource KeyBtn}">
            <Setter Property="Background" Value="{DynamicResource Signal}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSignal}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource KeyBtn}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,13" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="StepBtn" TargetType="Button" BasedOn="{StaticResource KeyBtn}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="Readout" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="62" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>

        <!-- Page-load reveal -->
        <Storyboard x:Key="Reveal">
            <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShellShift" Storyboard.TargetProperty="Y" From="16" To="0" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Idle lamp breathing -->
        <Storyboard x:Key="LampBreathe" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LampHalo" Storyboard.TargetProperty="Opacity" From="0.15" To="0.75" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Reveal}" />
            <BeginStoryboard Storyboard="{StaticResource LampBreathe}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid ClipToBounds="True">
        <!-- Drifting colour blobs behind the glass -->
        <Ellipse x:Name="BlobA" Width="520" Height="520" Fill="{DynamicResource Signal}" Opacity="0.28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-120,0" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="110" KernelType="Gaussian" /></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="BlobB" Width="460" Height="460" Fill="{DynamicResource Ice}" Opacity="0.2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="120,0,0,-180" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="110" KernelType="Gaussian" /></Ellipse.Effect>
        </Ellipse>

        <Grid x:Name="Shell">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ShellShift" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= COLLAPSIBLE RAIL ================= -->
            <Border x:Name="RailBorder" Grid.Column="0" Width="256" Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="14,24" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Wordmark: owl-M logo (tinted with the theme text colour) + name -->
                    <StackPanel Grid.Row="0" Margin="8,0,0,30">
                        <Rectangle Width="46" Height="36" Fill="{DynamicResource Text}" HorizontalAlignment="Left" ToolTip="Morseling">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="Assets/morseling-logo.png" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <StackPanel x:Name="BrandText">
                            <TextBlock Text="Morseling" FontFamily="{StaticResource Display}" FontSize="31" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,12,0,0" />
                            <TextBlock Text="MORSE CODE LEARNER" Style="{StaticResource Eyebrow}" Margin="2,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBlock x:Name="NavSectionLabel" Text="PRACTICE" Style="{StaticResource Eyebrow}" Margin="10,0,0,10" />
                        <Button x:Name="TabLearningBtn" Click="OnSelectLearningMode" ToolTip="Learning Drills"
                                Style="{StaticResource NavBtn}" Background="{DynamicResource Signal}" Foreground="{DynamicResource OnSignal}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="01" FontFamily="{StaticResource Mono}" FontSize="13" Width="30" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavLbl1" Text="Learning Drills" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabSentenceBtn" Click="OnSelectSentenceMode" ToolTip="Sentence Challenge" Style="{StaticResource NavBtn}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="02" FontFamily="{StaticResource Mono}" FontSize="13" Width="30" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavLbl2" Text="Sentence Challenge" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabSandboxBtn" Click="OnSelectSandboxMode" ToolTip="Freeform Sandbox" Style="{StaticResource NavBtn}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="03" FontFamily="{StaticResource Mono}" FontSize="13" Width="30" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavLbl3" Text="Freeform Sandbox" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabListenBtn" Click="OnSelectListenMode" ToolTip="Ear Training" Style="{StaticResource NavBtn}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="04" FontFamily="{StaticResource Mono}" FontSize="13" Width="30" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavLbl4" Text="Ear Training" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Rail footer: theme + collapse -->
                    <StackPanel Grid.Row="3">
                        <Button x:Name="ThemeBtn" Click="OnToggleTheme" ToolTip="Switch light / dark theme" Style="{StaticResource KeyBtn}" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ThemeIcon" Text="&#9790;" FontFamily="Segoe UI Symbol" FontSize="15" Width="30" VerticalAlignment="Center" />
                                <TextBlock x:Name="ThemeLabel" Text="Dark mode" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CollapseBtn" Click="OnToggleRail" ToolTip="Collapse / expand sidebar" Style="{StaticResource KeyBtn}" HorizontalContentAlignment="Left" Padding="14,11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CollapseIcon" Text="&#171;" FontFamily="{StaticResource Mono}" FontSize="16" FontWeight="Bold" Width="30" VerticalAlignment="Center" />
                                <TextBlock x:Name="CollapseLabel" Text="Collapse" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN ================= -->
            <Grid Grid.Column="1" Margin="26,20,26,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top bar: morse ticker + settings -->
                <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Card}" CornerRadius="14" Padding="10,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SPEED" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="4,0,8,0" />
                                <Button Content="&#8722;" Click="OnDecreaseWpm" Style="{StaticResource StepBtn}" />
                                <TextBlock x:Name="WpmDisplay" Text="15 WPM" Style="{StaticResource Readout}" Foreground="{DynamicResource Accent}" />
                                <Button Content="+" Click="OnIncreaseWpm" Style="{StaticResource StepBtn}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" CornerRadius="14" Padding="10,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TONE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="4,0,8,0" />
                                <Button Content="&#8722;" Click="OnDecreaseFrequency" Style="{StaticResource StepBtn}" />
                                <TextBlock x:Name="FrequencyDisplay" Text="700 Hz" Style="{StaticResource Readout}" Foreground="{DynamicResource Ice}" />
                                <Button Content="+" Click="OnIncreaseFrequency" Style="{StaticResource StepBtn}" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="ToggleStatsBtn" Content="Telemetry  ON" Click="OnToggleTelemetry"
                                Style="{StaticResource KeyBtn}" Foreground="{DynamicResource Accent}" Padding="14,10" />
                    </StackPanel>

                    <!-- Scrolling morse ticker, edges faded -->
                    <Border x:Name="TickerHost" ClipToBounds="True" Height="30" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="0.12" />
                                <GradientStop Color="#FF000000" Offset="0.88" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <StackPanel x:Name="TickerStrip" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.5">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="TickerShift" />
                            </StackPanel.RenderTransform>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <!-- Active mode surface -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="34,30" Margin="0,0,0,16">
                    <Grid>

                        <!-- MODE 1: LEARNING DRILLS -->
                        <Grid x:Name="PanelLearning" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="LearnHeader" Grid.Row="0">
                                <TextBlock Text="LEVEL 1" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Accent}" />
                                <TextBlock Text="Character recognition" Style="{StaticResource H1}" Margin="0,2,0,0" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <Grid x:Name="LearnBody" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Glyph tile: gradient rim + inner glow -->
                                    <Border x:Name="LearnGlyphTile" Grid.Row="0" Grid.Column="0" Width="250" Height="250" CornerRadius="32" BorderThickness="2" Margin="0,0,44,0" VerticalAlignment="Center">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource SignalColor}" Offset="0" />
                                                <GradientStop Color="{DynamicResource IceColor}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.3" RadiusX="0.9" RadiusY="0.9">
                                                <GradientStop Color="{DynamicResource RaisedColor}" Offset="0" />
                                                <GradientStop Color="{DynamicResource WellColor}" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                        <Viewbox Margin="26" Stretch="Uniform">
                                            <TextBlock x:Name="LearnTargetChar" Text="A" FontFamily="{StaticResource Display}" FontSize="168" FontWeight="Bold"
                                                       Foreground="{DynamicResource Text}" />
                                        </Viewbox>
                                    </Border>

                                    <StackPanel x:Name="LearnInfoPanel" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" MinWidth="320">
                                        <TextBlock x:Name="LearnPatternLabel" Text="SEND THIS PATTERN" Style="{StaticResource Eyebrow}" />
                                        <TextBlock x:Name="LearnTargetMorse" Text="&#8226; &#9472;" FontFamily="{StaticResource Mono}" FontSize="48" FontWeight="Bold"
                                                   Foreground="{DynamicResource Signal}" Margin="0,4,0,0" />
                                        <TextBlock x:Name="LearnTargetPhonetic" Text="Phonetic: di-dah" FontFamily="{StaticResource Display}" FontSize="18"
                                                   Foreground="{DynamicResource Muted}" Margin="0,0,0,14" />

                                        <Border x:Name="LearnFeedbackBox" Background="{DynamicResource Raised}" CornerRadius="14" Padding="18,14" HorizontalAlignment="Left" MinWidth="320" MaxWidth="460">
                                            <TextBlock x:Name="LearnFeedbackText" Text="Key in [ &#8226; &#9472; ] using the Spacebar" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ice}" TextWrapping="Wrap" />
                                        </Border>

                                        <WrapPanel Margin="0,16,0,0">
                                            <Button Content="Next character  &#8594;" Click="OnNextLearnChar" Style="{StaticResource SignalBtn}" Margin="0,0,20,6" />
                                            <TextBlock x:Name="LearnScoreText" Text="Score: 0 / 0 (0%)  &#183;  Streak: 0" FontFamily="{StaticResource Mono}" FontSize="13"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,0,6" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                            <Border x:Name="LearnChipsPanel" Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="LearnChipsLabel" Text="ALPHABET" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />
                                    <WrapPanel x:Name="LearnChipsWrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- MODE 2: SENTENCE COPY CHALLENGE -->
                        <Grid x:Name="PanelSentence" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="LEVEL 2" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Accent}" />
                                <TextBlock Text="Sentence challenge" Style="{StaticResource H1}" Margin="0,2,0,16" />
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="HELLO WORLD"   Click="OnPresetSelected" Style="{StaticResource KeyBtn}" Padding="14,7" Margin="0,0,8,6" />
                                    <Button Content="SOS EMERGENCY" Click="OnPresetSelected" Style="{StaticResource KeyBtn}" Padding="14,7" Margin="0,0,8,6" />
                                    <Button Content="CQ CQ DE"      Click="OnPresetSelected" Style="{StaticResource KeyBtn}" Padding="14,7" Margin="0,0,8,6" />
                                    <Button Content="PARIS (STD)"   Click="OnPresetSelected" Style="{StaticResource KeyBtn}" Padding="14,7" Margin="0,0,8,6" />
                                </WrapPanel>
                                <DockPanel>
                                    <Button Content="Set phrase" Click="OnSetCustomSentence" DockPanel.Dock="Right" Style="{StaticResource SignalBtn}" />
                                    <TextBox x:Name="CustomPhraseInput" Text="ENTER YOUR OWN SENTENCE HERE"
                                             Background="{DynamicResource Raised}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}"
                                             CaretBrush="{DynamicResource Accent}" SelectionBrush="{DynamicResource Signal}"
                                             FontFamily="{StaticResource Mono}" FontSize="13" Padding="14,10" Margin="0,0,10,0" VerticalContentAlignment="Center" />
                                </DockPanel>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16">
                                <Border Background="{DynamicResource Well}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="22,18" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <WrapPanel x:Name="SentenceLettersWrap" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                        <WrapPanel HorizontalAlignment="Center">
                                            <TextBlock Text="SEND" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SentenceActiveChar" Text="H" FontFamily="{StaticResource Display}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="12,0,20,0" />
                                            <TextBlock Text="AS" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SentenceActiveMorse" Text="&#8226;&#8226;&#8226;&#8226;" FontFamily="{StaticResource Mono}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Ice}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0" ToolTip="Full transmission">
                                            <StackPanel>
                                                <TextBlock x:Name="SentenceFullMorse" FontFamily="{StaticResource Mono}" FontSize="15" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="680" LineHeight="24" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>

                            <DockPanel Grid.Row="2">
                                <Button Content="Reset" Click="OnResetSentence" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" HorizontalAlignment="Right" />
                                <TextBlock x:Name="SentenceProgressText" Text="Progress: 0 / 11 Characters (0%)" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Grid>

                        <!-- MODE 3: FREEFORM TELEGRAPH SANDBOX -->
                        <Grid x:Name="PanelSandbox" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                                <TextBlock Text="OPEN KEY" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Accent}" />
                                <TextBlock Text="Freeform sandbox" Style="{StaticResource H1}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource Well}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="24,18">
                                    <DockPanel>
                                        <TextBlock Text="DECODED STREAM" DockPanel.Dock="Top" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />
                                        <Grid>
                                            <TextBlock x:Name="SandboxHint" Text="Press and release SPACE to start transmitting. Pause for about six units (roughly half a second at 15 WPM) to add a word space."
                                                       FontFamily="{StaticResource Display}" FontSize="20" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" IsHitTestVisible="False" Opacity="0.8" />
                                            <TextBox x:Name="SandboxStreamBox" Text="" TextChanged="OnSandboxTextChanged" FontSize="32" FontFamily="{StaticResource Mono}" FontWeight="SemiBold"
                                                     Foreground="{DynamicResource Accent}" CaretBrush="{DynamicResource Accent}"
                                                     Background="Transparent" BorderThickness="0" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="SandboxRef" Grid.Column="1" Width="270" Margin="16,0,0,0" Background="{DynamicResource Raised}" CornerRadius="18" Padding="18,16">
                                    <DockPanel>
                                        <TextBlock Text="QUICK REFERENCE" DockPanel.Dock="Top" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <WrapPanel x:Name="ReferenceWrap" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Content="Play in Morse" Click="OnPlaySandboxMorse" Style="{StaticResource SignalBtn}" Margin="0,0,8,0" />
                                <Button Content="Copy text" Click="OnCopySandboxText" Style="{StaticResource KeyBtn}" Margin="0,0,8,0" />
                                <Button Content="Clear" Click="OnClearSandbox" Style="{StaticResource KeyBtn}" Foreground="{DynamicResource Alert}" />
                            </WrapPanel>
                        </Grid>
                        <!-- MODE 4: EAR TRAINING -->
                        <Grid x:Name="PanelListen" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel x:Name="ListenHeader" Grid.Row="0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ListenTabPathBtn" Content="Study path" Click="OnListenTabPath" Style="{StaticResource KeyBtn}" Padding="16,8" Margin="0,0,6,0" />
                                    <Button x:Name="ListenTabPracticeBtn" Content="Free practice" Click="OnListenTabPractice" Style="{StaticResource KeyBtn}" Padding="16,8" />
                                </StackPanel>
                                <StackPanel x:Name="ListenTitleBlock">
                                    <TextBlock x:Name="ListenEyebrow" Text="LEVEL 4" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Accent}" />
                                    <TextBlock x:Name="ListenTitle" Text="Study path" Style="{StaticResource H1}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <!-- VIEW: STUDY PATH (lesson hub) -->
                            <Grid x:Name="ListenHubView" Grid.Row="1" Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <Button x:Name="ListenResetBtn" Content="Reset progress" Click="OnListenResetProgress" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Padding="12,6" FontSize="12" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock x:Name="ListenHubSummary" Text="" FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                        <TextBlock Text="Ten short lessons. Each group is introduced, drilled by ear until every character is mastered, and mixed with earlier groups so nothing fades."
                                                   FontSize="13" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,12,0" />
                                    </StackPanel>
                                </DockPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel x:Name="ListenLessonWrap" />
                                </ScrollViewer>
                            </Grid>

                            <!-- VIEW: LESSON GUIDE (learn the group before drilling) -->
                            <Grid x:Name="ListenGuideView" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock x:Name="GuideTip" Text="" FontSize="14" Foreground="{DynamicResource Text}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="GuideBeginBtn" Content="Begin drills  &#8594;" Click="OnGuideBegin" Style="{StaticResource SignalBtn}" Margin="0,0,8,6" />
                                        <Button x:Name="GuideHearAllBtn" Content="&#9654;  Hear all" Click="OnGuideHearAll" Style="{StaticResource KeyBtn}" Margin="0,0,8,6" />
                                        <Button Content="Back to path" Click="OnListenTabPath" Style="{StaticResource KeyBtn}" Margin="0,0,0,6" />
                                    </WrapPanel>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel x:Name="GuideCardsWrap" />
                                </ScrollViewer>
                            </Grid>

                            <!-- VIEW: DRILL (shared by lessons and free practice) -->
                            <Grid x:Name="ListenDrillView" Grid.Row="1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <WrapPanel x:Name="ListenContextBar" Grid.Row="0" Margin="0,10,0,0">
                                    <TextBlock x:Name="ListenScopeLabel" Text="" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,16,6" />
                                    <StackPanel x:Name="ListenFilterPanel" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button x:Name="ListenLettersBtn" Content="Letters" Click="OnToggleLetters" Style="{StaticResource KeyBtn}" Padding="14,5" FontSize="12" Margin="0,0,6,0" />
                                        <Button x:Name="ListenNumbersBtn" Content="Numbers" Click="OnToggleNumbers" Style="{StaticResource KeyBtn}" Padding="14,5" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel x:Name="ListenLessonBar" Orientation="Horizontal" Margin="0,0,0,6">
                                        <WrapPanel x:Name="ListenMasteryWrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Content="Lesson guide" Click="OnDrillGuide" Style="{StaticResource KeyBtn}" Padding="12,5" FontSize="12" Margin="0,0,6,0" />
                                        <Button x:Name="ListenNextLessonBtn" Content="Next lesson  &#8594;" Click="OnNextLesson" Style="{StaticResource SignalBtn}" Padding="12,5" FontSize="12" Visibility="Collapsed" />
                                    </StackPanel>
                                </WrapPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <Grid x:Name="ListenBody" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border x:Name="ListenTile" Grid.Row="0" Grid.Column="0" Width="230" Height="230" CornerRadius="32" BorderThickness="2" Margin="0,0,40,0" VerticalAlignment="Center">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource IceColor}" Offset="0" />
                                                <GradientStop Color="{DynamicResource SignalColor}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.3" RadiusX="0.9" RadiusY="0.9">
                                                <GradientStop Color="{DynamicResource RaisedColor}" Offset="0" />
                                                <GradientStop Color="{DynamicResource WellColor}" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                        <Viewbox Margin="30" Stretch="Uniform">
                                            <TextBlock x:Name="ListenAnswerChar" Text="?" FontFamily="{StaticResource Display}" FontSize="168" FontWeight="Bold" Foreground="{DynamicResource Text}" />
                                        </Viewbox>
                                    </Border>

                                    <StackPanel x:Name="ListenInfoPanel" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" MinWidth="380">
                                        <TextBlock Text="LISTEN, THEN NAME THE CHARACTER" Style="{StaticResource Eyebrow}" />
                                        <WrapPanel Margin="0,10,0,6">
                                            <Button x:Name="ListenPlayBtn" Content="&#9654;  Play sound" Click="OnListenReplay" Style="{StaticResource SignalBtn}" Margin="0,0,8,8" />
                                            <Button x:Name="ListenRevealBtn" Content="Show answer" Click="OnListenReveal" Style="{StaticResource KeyBtn}" Margin="0,0,8,8" />
                                            <Button x:Name="ListenNextBtn" Content="Next  &#8594;" Click="OnListenNext" Style="{StaticResource KeyBtn}" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <Border Background="{DynamicResource Raised}" CornerRadius="14" Padding="18,14" MinHeight="112" MaxWidth="480" HorizontalAlignment="Left">
                                            <StackPanel>
                                                <TextBlock x:Name="ListenFeedbackText" Text="Listening..." FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ice}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="ListenDiagramHint" Text="The dit-dah diagram appears once you answer or show the answer." Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" />
                                                <StackPanel x:Name="ListenDiagramPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                                    <WrapPanel x:Name="ListenDiagram" />
                                                    <TextBlock x:Name="ListenPhonetic" FontFamily="{StaticResource Display}" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="ListenScoreText" Text="First try: 0 / 0 (0%)  &#183;  Streak: 0" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <Border x:Name="ListenChipsPanel" Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="ListenChipsLabel" Text="YOUR ANSWER  &#183;  CLICK, TYPE THE CHARACTER, OR KEY IT IN MORSE" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />
                                    <WrapPanel x:Name="ListenChipsWrap" />
                                </StackPanel>
                            </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============ KEY CONSOLE: lamp + buffer + telemetry ============ -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,16">
                    <Grid x:Name="ConsoleGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Lamp -->
                        <Grid x:Name="LampHost" Grid.Row="0" Grid.Column="0" Width="124" Height="124" Margin="0,0,22,0">
                            <Grid.LayoutTransform><ScaleTransform x:Name="LampScale" /></Grid.LayoutTransform>
                            <Ellipse x:Name="LampHalo" Width="122" Height="122" Stroke="{DynamicResource Signal}" StrokeThickness="3" Opacity="0.3" />
                            <Ellipse Width="112" Height="112" Fill="{DynamicResource Well}" Stroke="{DynamicResource Line}" StrokeThickness="1" />
                            <Ellipse x:Name="SignalBulb" Width="86" Height="86" Fill="{DynamicResource Raised}">
                                <Ellipse.Effect>
                                    <BlurEffect x:Name="SignalGlow" Radius="0" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="SignalStatusText" Text="KEY UP" FontFamily="{StaticResource Mono}" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Live key scope + buffer -->
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" MinWidth="260">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="KeyReadout" DockPanel.Dock="Right" Text="1 unit = 80 ms" FontFamily="{StaticResource Mono}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="LIVE KEY SCOPE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                            </DockPanel>
                            <c:KeyScope x:Name="KeyScope" Height="76" HorizontalAlignment="Stretch" />
                            <DockPanel Margin="0,8,0,0">
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1,1,1,3" CornerRadius="7" Padding="12,2" VerticalAlignment="Center" ToolTip="Or your external assistive switch">
                                    <TextBlock Text="SPACE" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text}" />
                                </Border>
                                <TextBlock x:Name="CurrentTokenBuffer" Text="" FontSize="26" FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                           Foreground="{DynamicResource Accent}" MinHeight="34" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </StackPanel>
                        <!-- Telemetry (toggleable) -->
                        <Border x:Name="TelemetryBar" Grid.Row="0" Grid.Column="2" Background="{DynamicResource Well}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="22,14" VerticalAlignment="Center" Visibility="Visible">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,34,12">
                                    <TextBlock Text="LAST DURATION" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="DurationMetric" Text="0 ms" FontFamily="{StaticResource Mono}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                    <TextBlock Text="TOKEN" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="TokenMetric" Text="NONE" FontFamily="{StaticResource Mono}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,34,0">
                                    <TextBlock Text="MODE" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="ModeMetric" Text="LEARNING" FontFamily="{StaticResource Mono}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ice}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="MASM CORE" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="LatencyMetric" Text="&lt; 0.05 &#956;s (O(1))" FontFamily="{StaticResource Mono}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Mint}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
