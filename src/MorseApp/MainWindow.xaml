<Window x:Class="MorseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MorseCodeLearner - Assistive x64 Assembly Platform" 
        Height="780" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="#121212">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Top Header & Navigation Bar -->
            <RowDefinition Height="*" />
            <!-- Active Mode Workspace -->
            <RowDefinition Height="Auto" />
            <!-- Telemetry Footer (Toggleable) -->
        </Grid.RowDefinitions>
        <!-- 1. Top Header & Mode Navigation Menu -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="⚡ MORSE CODE LEARNER" FontSize="18" FontWeight="Black" Foreground="#FFD600" VerticalAlignment="Center" />
                    <TextBlock Text=" │ x64 Native Core" FontSize="13" Foreground="#707070" Margin="8,0,20,0" VerticalAlignment="Center" />
                    <!-- Mode Selector Buttons -->
                    <Border Background="#121212" CornerRadius="6" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabLearningBtn" Content="🎓 Learning Drills" Click="OnSelectLearningMode"
                                    Focusable="False" Background="#FFD600" Foreground="Black" FontWeight="Bold" Padding="14,6" Margin="2" BorderThickness="0" Cursor="Hand" />
                            <Button x:Name="TabSentenceBtn" Content="📝 Sentence Challenge" Click="OnSelectSentenceMode"
                                    Focusable="False" Background="Transparent" Foreground="#A0A0A0" FontWeight="SemiBold" Padding="14,6" Margin="2" BorderThickness="0" Cursor="Hand" />
                            <Button x:Name="TabSandboxBtn" Content="📻 Freeform Sandbox" Click="OnSelectSandboxMode"
                                    Focusable="False" Background="Transparent" Foreground="#A0A0A0" FontWeight="SemiBold" Padding="14,6" Margin="2" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Speed, Sidetone & Settings Toggle -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="SPEED:" FontSize="12" FontWeight="Bold" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Content="-" Click="OnDecreaseWpm" Focusable="False" Background="#2A2A2A" Foreground="White" Width="26" Height="26" FontWeight="Bold" BorderThickness="0" Cursor="Hand" />
                    <TextBlock x:Name="WpmDisplay" Text="15 WPM" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="8,0" VerticalAlignment="Center" />
                    <Button Content="+" Click="OnIncreaseWpm" Focusable="False" Background="#2A2A2A" Foreground="White" Width="26" Height="26" FontWeight="Bold" BorderThickness="0" Cursor="Hand" />
                    <TextBlock Text="│ SIDETONE: 700 Hz" FontSize="12" FontWeight="SemiBold" Foreground="#A0A0A0" Margin="14,0,16,0" VerticalAlignment="Center" />
                    <!-- Statistics / Telemetry Settings Toggle Button -->
                    <Button x:Name="ToggleStatsBtn" Content="⚙ Statistics: ON" Click="OnToggleTelemetry"
                            Focusable="False" Background="#2A2A2A" Foreground="#FFD600" FontWeight="Bold" FontSize="12" Padding="12,6" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- 2. Main Workspace Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <!-- LEFT PANEL: Dynamic Modes -->
            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Padding="24" Margin="0,0,16,0">
                <Grid>
                    <!-- MODE 1: LEARNING DRILLS -->
                    <Grid x:Name="PanelLearning" Visibility="Visible">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="LEVEL 1: CHARACTER RECOGNITION" FontSize="13" FontWeight="Bold" Foreground="#707070" HorizontalAlignment="Center" />
                            <TextBlock x:Name="LearnTargetChar" Text="A" FontSize="120" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,4" />
                            <TextBlock x:Name="LearnTargetMorse" Text="• ─" FontSize="42" FontWeight="Bold" Foreground="#FFD600" HorizontalAlignment="Center" />
                            <TextBlock x:Name="LearnTargetPhonetic" Text="Phonetic: di-dah" FontSize="18" FontStyle="Italic" Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,6,0,16" />
                            <Border x:Name="LearnFeedbackBox" Background="#121212" CornerRadius="6" Padding="14,10" MinWidth="400">
                                <TextBlock x:Name="LearnFeedbackText" Text="Key in [ • ─ ] using the Spacebar" FontSize="16" FontWeight="SemiBold" Foreground="#00E5FF" TextAlignment="Center" />
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <TextBlock x:Name="LearnScoreText" Text="Score: 0 / 0 (0%)  │  Streak: 0 🔥" FontSize="14" FontWeight="Bold" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,20,0" />
                                <Button Content="Next Char →" Click="OnNextLearnChar" Focusable="False" Background="#2A2A2A" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <!-- MODE 2: SENTENCE COPY CHALLENGE -->
                    <Grid x:Name="PanelSentence" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="SELECT CHALLENGE PRESET OR ENTER CUSTOM TEXT:" FontSize="12" FontWeight="Bold" Foreground="#707070" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="HELLO WORLD" Click="OnPresetSelected" Focusable="False" Background="#2A2A2A" Foreground="White" Padding="10,6" Margin="0,0,8,6" BorderThickness="0" Cursor="Hand" />
                                <Button Content="SOS EMERGENCY" Click="OnPresetSelected" Focusable="False" Background="#2A2A2A" Foreground="White" Padding="10,6" Margin="0,0,8,6" BorderThickness="0" Cursor="Hand" />
                                <Button Content="CQ CQ DE" Click="OnPresetSelected" Focusable="False" Background="#2A2A2A" Foreground="White" Padding="10,6" Margin="0,0,8,6" BorderThickness="0" Cursor="Hand" />
                                <Button Content="PARIS (STD)" Click="OnPresetSelected" Focusable="False" Background="#2A2A2A" Foreground="White" Padding="10,6" Margin="0,0,8,6" BorderThickness="0" Cursor="Hand" />
                            </WrapPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Button Content="Set Custom Phrase" Click="OnSetCustomSentence" Focusable="False" DockPanel.Dock="Right" Background="#FFD600" Foreground="Black" FontWeight="Bold" Padding="14,6" BorderThickness="0" Cursor="Hand" />
                                <TextBox x:Name="CustomPhraseInput" Text="ENTER YOUR OWN SENTENCE HERE" Background="#121212" Foreground="#FFFFFF" BorderBrush="#333333" FontSize="13" Padding="8,6" Margin="0,0,8,0" />
                            </DockPanel>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#121212" CornerRadius="8" Padding="20" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="SENTENCE TRANSCRIPTION TARGET:" FontSize="12" FontWeight="Bold" Foreground="#707070" Margin="0,0,0,10" HorizontalAlignment="Center" />
                                <WrapPanel x:Name="SentenceLettersWrap" HorizontalAlignment="Center" Margin="0,10" />
                                <Border Background="#1E1E1E" CornerRadius="6" Padding="16,10" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="CURRENT KEY TARGET: " FontSize="14" FontWeight="Bold" Foreground="#A0A0A0" />
                                        <TextBlock x:Name="SentenceActiveChar" Text="H" FontSize="18" FontWeight="Black" Foreground="#FFD600" Margin="6,0" />
                                        <TextBlock Text=" ➔ MORSE: " FontSize="14" FontWeight="Bold" Foreground="#A0A0A0" />
                                        <TextBlock x:Name="SentenceActiveMorse" Text="••••" FontSize="18" FontWeight="Bold" Foreground="#00E5FF" Margin="6,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <DockPanel Grid.Row="2" Margin="0,14,0,0">
                            <TextBlock x:Name="SentenceProgressText" Text="Progress: 0 / 11 Characters (0%)" FontSize="13" FontWeight="Bold" Foreground="#A0A0A0" VerticalAlignment="Center" />
                            <Button Content="Reset Challenge" Click="OnResetSentence" Focusable="False" DockPanel.Dock="Right" Background="#2A2A2A" Foreground="White" Padding="12,6" BorderThickness="0" Cursor="Hand" />
                        </DockPanel>
                    </Grid>
                    <!-- MODE 3: FREEFORM TELEGRAPH SANDBOX -->
                    <Grid x:Name="PanelSandbox" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="FREE TELEGRAPH TRANSCRIBER &amp; PLAYBACK" FontSize="13" FontWeight="Bold" Foreground="#707070" Margin="0,0,0,12" />
                        <Border Grid.Row="1" Background="#121212" CornerRadius="8" Padding="16">
                            <DockPanel>
                                <TextBlock Text="LIVE DECODED TEXT STREAM:" DockPanel.Dock="Top" FontSize="11" FontWeight="Bold" Foreground="#707070" Margin="0,0,0,8" />
                                <TextBox x:Name="SandboxStreamBox" Text="" FontSize="28" FontFamily="Consolas" FontWeight="Bold" Foreground="#00E5FF" 
                                         Background="Transparent" BorderThickness="0" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
                            </DockPanel>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="🔊 Hear in Morse" Click="OnPlaySandboxMorse" Focusable="False" Background="#2A2A2A" Foreground="#00E676" FontWeight="Bold" Padding="14,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand" />
                            <Button Content="📋 Copy Text" Click="OnCopySandboxText" Focusable="False" Background="#2A2A2A" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand" />
                            <Button Content="🧹 Clear" Click="OnClearSandbox" Focusable="False" Background="#2A2A2A" Foreground="#FF3D00" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <!-- RIGHT PANEL: Universal Hardware Signal Beacon & Buffer -->
            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="VISUAL SIGNAL BEACON" FontSize="13" FontWeight="Bold" Foreground="#707070" HorizontalAlignment="Center" Margin="0,0,0,18" />
                    <Grid Width="150" Height="150">
                        <Ellipse Width="140" Height="140" Stroke="#333333" StrokeThickness="4" />
                        <Ellipse x:Name="SignalBulb" Width="110" Height="110" Fill="#2A2A2A">
                            <Ellipse.Effect>
                                <BlurEffect x:Name="SignalGlow" Radius="0" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="SignalStatusText" Text="KEY UP" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="LIVE KEY BUFFER:" FontSize="11" FontWeight="Bold" Foreground="#707070" Margin="0,20,0,4" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CurrentTokenBuffer" Text="" FontSize="34" FontFamily="Consolas" FontWeight="Black" Foreground="#FFD600" HorizontalAlignment="Center" MinHeight="44" />
                    <Border Background="#121212" CornerRadius="6" Padding="10,8" Margin="0,16,0,0">
                        <TextBlock Text="INPUT: [ SPACEBAR ]&#x0a;OR EXTERNAL ASSISTIVE SWITCH" FontSize="10" FontWeight="Bold" Foreground="#707070" TextAlignment="Center" LineHeight="16" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        <!-- 3. Bottom Telemetry Bar (Toggleable from Settings) -->
        <Border x:Name="TelemetryBar" Grid.Row="2" Background="#1E1E1E" CornerRadius="8" Padding="12,14" Margin="0,16,0,0" Visibility="Visible">
            <UniformGrid Columns="4">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="LAST DURATION" FontSize="11" Foreground="#707070" />
                    <TextBlock x:Name="DurationMetric" Text="0 ms" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="CLASSIFIED TOKEN" FontSize="11" Foreground="#707070" />
                    <TextBlock x:Name="TokenMetric" Text="NONE" FontSize="17" FontWeight="Bold" Foreground="#FFD600" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="CURRENT MODE" FontSize="11" Foreground="#707070" />
                    <TextBlock x:Name="ModeMetric" Text="LEARNING" FontSize="17" FontWeight="Bold" Foreground="#00E5FF" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="MASM CORE LATENCY" FontSize="11" Foreground="#707070" />
                    <TextBlock x:Name="LatencyMetric" Text="&lt; 0.05 μs (O(1))" FontSize="17" FontWeight="Bold" Foreground="#00E676" />
                </StackPanel>
            </UniformGrid>
        </Border>
    </Grid>
</Window>